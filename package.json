{
  "name": "vuelidate",
  "version": "1.0.0",
  "private": true,
  "description": "Simple, lightweight model-based validation for Vue.js",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vuelidate/vuelidate.git"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "2.4.6",
    "babel-jest": "^29.7.0",
    "core-js": "^3.42.0",
    "flush-promises": "^1.0.2",
    "jest": "^27.0.6",
    "jest-serializer-vue": "^3.1.0",
    "rollup": "^4.40.1",
    "rollup-plugin-copy": "^3.5.0",
    "vue": "^3.5.13"
  },
  "scripts": {
    "build": "npm -w @vuelidate/core run build && npm -w @vuelidate/validators run build && npm -w @vuelidate/components run build",
    "test": "jest",
    "prepare": "rm -rf packages/vuelidate/dist packages/validators/dist && npm run build"
  }
}
