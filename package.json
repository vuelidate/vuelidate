{
  "name": "vuelidate",
  "version": "1.0.0",
  "private": true,
  "description": "Simple, lightweight model-based validation for Vue.js",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vuelidate/vuelidate.git"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@vue/compiler-sfc": "^3.5.13",
    "@vue/test-utils": "^2.0.0-rc.12",
    "babel-jest": "^29.7.0",
    "core-js": "^3.42.0",
    "flush-promises": "^1.0.2",
    "jest": "^27.0.6",
    "jest-serializer-vue": "^2.0.2",
    "rollup": "^4.40.1",
    "rollup-plugin-copy": "^3.5.0",
    "vue": "^3.5.13",
    "vue-template-compiler": "^2.7.16"
  },
  "scripts": {
    "build": "yarn workspace @vuelidate/core build && yarn workspace @vuelidate/validators build && yarn workspace @vuelidate/components build",
    "test": "jest",
    "prepare": "rm -rf packages/vuelidate/dist packages/validators/dist && yarn build"
  }
}
